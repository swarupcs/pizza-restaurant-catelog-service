# Catalog Service - Environment Variables Example
# Copy this file to .env.development or .env.production and fill in the values.
# These environment variables override values in config/development.yaml or config/production.yaml
# via config/custom-environment-variables.yaml

# Server
PORT=5502

# MongoDB
DB_URL=mongodb://localhost:27017/catalog-service-db

# Kafka
KAFKA_BROKER=["localhost:9092"]
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Auth (JWKS endpoint from auth-service)
JWKS_URI=http://localhost:5501/.well-known/jwks.json

# AWS S3 (for product image uploads)
S3_REGION=ap-south-1
S3_BUCKET=catalog-service-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# CORS - Allowed frontend origins
CLIENT_UI_DOMAIN=http://localhost:5173
ADMIN_UI_DOMAIN=http://localhost:5174
